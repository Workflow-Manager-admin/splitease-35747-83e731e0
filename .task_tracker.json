{
  "task_description": "{'component_name': 'Main Container for SplitEase', 'description': 'Primary container for SplitEase implementation: SnapSplit is a responsive web app for uploading and parsing receipts using Google Cloud Vision OCR, splitting expenses among friends, and settling up via Venmo or PayPal. It features user authentication, a dashboard for managing receipts, real-time item assignment, and a history of past bills. Data and images are securely stored using Supabase services, and the UI is styled with TailwindCSS for a modern experience.', 'interfaces': [], 'framework': 'react', 'platform': 'web', 'container': '{\n  "name": "SplitEase-35747 frontend Container",\n  "features": [\n    {\n      "name": "User Authentication",\n      "description": "Sign up and log in using email/password or Google OAuth via Supabase Auth.",\n      "isEnabled": true\n    },\n    {\n      "name": "Receipt Upload & Storage",\n      "description": "Upload JPG, PNG, or PDF receipts, which are stored in Supabase Storage.",\n      "isEnabled": true\n    },\n    {\n      "name": "OCR Parsing",\n      "description": "Automatically extract item names, prices, subtotal, tax, and total from receipts using Google Cloud Vision API.",\n      "isEnabled": true\n    },\n    {\n      "name": "Dashboard",\n      "description": "View and manage uploaded receipts and access past receipts.",\n      "isEnabled": true\n    },\n    {\n      "name": "Item Assignment UI",\n      "description": "Assign each line item to friends using a drag-and-drop or checkbox interface.",\n      "isEnabled": true\n    },\n    {\n      "name": "Real-time Split Calculation",\n      "description": "Automatically calculate each person\'s share, including tax and tip, with real-time updates as items are assigned.",\n      "isEnabled": true\n    },\n    {\n      "name": "Settle-up Page",\n      "description": "Send or request payments via Venmo or PayPal API integration.",\n      "isEnabled": true\n    },\n    {\n      "name": "History & Export",\n      "description": "View all past bills, payment status, and export receipt breakdowns as PDF.",\n      "isEnabled": true\n    },\n    {\n      "name": "Supabase Database Integration",\n      "description": "Store users, receipts, items, and payment status in Supabase Database.",\n      "isEnabled": true\n    },\n    {\n      "name": "Modern UI with TailwindCSS",\n      "description": "Responsive, modern interface with smooth transitions using TailwindCSS.",\n      "isEnabled": true\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "React JS"\n    ],\n    "backend": [\n      "None"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#2563eb",\n    "secondary": "#f1f5f9",\n    "accent": "#f59e42"\n  },\n  "theme": "light",\n  "layoutDescription": "The app features a responsive dashboard with a sidebar for navigation (Dashboard, History, Settle-up). The main area displays receipt upload and parsing, with a visual item assignment interface (drag-and-drop or checkboxes). Real-time split calculations are shown in a summary panel. The history page lists past bills with export options. All pages use modern, clean layouts with TailwindCSS and smooth transitions."\n}'}",

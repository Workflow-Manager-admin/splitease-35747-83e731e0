# .env.example for SplitEase frontend

# Supabase project URL (found in your Supabase dashboard > Project > API)
REACT_APP_SUPABASE_URL=your-supabase-url-here

# Supabase public "anon" key (found in your Supabase dashboard > Project > API > anon public key)
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# Copy this file to .env in the root of splitease_frontend/ and fill in actual values for local development.

